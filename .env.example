# Copy to .env and fill in real values. Never commit the real .env.

# ---- Database ----
DB_HOST=
DB_PORT=6543
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
DB_CONNECT_TIMEOUT=5
DB_POOL_MIN=1
DB_POOL_MAX=10

# ---- Auth ----
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_TTL_HOURS=2

# ---- CORS ----
# Comma-separated list of allowed frontend origins
FRONTEND_ORIGINS=https://your-frontend.example.com,http://localhost:3000

# ---- App ----
PORT=5000
LOG_LEVEL=INFO

# ---- One-time admin seed ----
# Fill these in, run `python seed_admin.py` once, then blank them out again.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=
ADMIN_TEAM=
